# --- Contact form delivery (option 1: Gmail SMTP, recommended) ---
# Gmail address the form sends from (must match the app-password account).
GMAIL_USER=
# Google "app password" (requires 2-Step Verification):
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
GMAIL_APP_PASSWORD=
# Where visitor inquiries land. Defaults to GMAIL_USER when unset.
CONTACT_TO_EMAIL=

# --- Contact form delivery (option 2: generic webhook) ---
# Used only when the Gmail vars above are unset. Forwards the contact
# form JSON to your inbox tool of choice (Formspree, Resend, Slack …).
# Without either option, submissions are only logged server-side.
# Set these in the Vercel dashboard: Project Settings -> Environment Variables.
CONTACT_WEBHOOK_URL=
